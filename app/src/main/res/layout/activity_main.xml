<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_tabbar"
    android:orientation="vertical">

    <!-- Row 1: tab bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg_tabbar"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingTop="6dp">

        <HorizontalScrollView
            android:id="@+id/tab_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tab_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <com.growbig.browser.ui.ToolbarIcon
            android:id="@+id/btn_new_tab"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:contentDescription="@string/cd_new_tab"
            android:focusable="true"
            android:padding="7dp"
            app:iconType="plus" />
    </LinearLayout>

    <!-- Row 2: navigation toolbar + address bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <com.growbig.browser.ui.ToolbarIcon
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="8dp"
            app:iconType="back" />

        <com.growbig.browser.ui.ToolbarIcon
            android:id="@+id/btn_forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:contentDescription="@string/cd_forward"
            android:focusable="true"
            android:padding="8dp"
            app:iconType="forward" />

        <com.growbig.browser.ui.ToolbarIcon
            android:id="@+id/btn_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:contentDescription="@string/cd_refresh"
            android:focusable="true"
            android:padding="8dp"
            app:iconType="refresh" />

        <com.growbig.browser.ui.ToolbarIcon
            android:id="@+id/btn_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:contentDescription="@string/cd_home"
            android:focusable="true"
            android:padding="8dp"
            app:iconType="home" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/address_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.growbig.browser.ui.ToolbarIcon
                android:id="@+id/icon_secure"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/cd_security"
                android:padding="8dp"
                app:iconColor="@color/text_hint"
                app:iconType="search" />

            <EditText
                android:id="@+id/address_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_address"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <com.growbig.browser.ui.ToolbarIcon
                android:id="@+id/btn_clear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/btn_bg"
                android:clickable="true"
                android:contentDescription="@string/cd_clear"
                android:focusable="true"
                android:padding="9dp"
                android:visibility="gone"
                app:iconColor="@color/text_hint"
                app:iconType="close" />
        </LinearLayout>

        <com.growbig.browser.ui.ToolbarIcon
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:contentDescription="@string/cd_menu"
            android:focusable="true"
            android:padding="8dp"
            app:iconType="menu" />
    </LinearLayout>

    <!-- Page loading progress -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/progress_bar"
        android:visibility="gone" />

    <!-- Web content: the active tab's WebView is placed here. -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_toolbar"
        android:focusable="true"
        android:focusableInTouchMode="true" />
</LinearLayout>
